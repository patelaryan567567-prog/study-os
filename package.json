{
  "name": "studyos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-firebase-config.mjs",
    "dev": "vite",
    "prebuild": "node scripts/prepare-firebase-config.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "electron .",
    "build:electron": "node scripts/build-electron.mjs",
    "electron:dev": "node scripts/build-electron.mjs && electron .",
    "electron": "npm run build && npm run build:electron && electron .",
    "electron:build": "npm run build && node scripts/build-electron.mjs && electron-builder --win --config electron/electron-builder.yml",
    "sign": "node scripts/sign-release.mjs",
    "app:build": "npm run build && npm run build:electron && electron-builder --win --config electron/electron-builder.yml"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.4.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.17.0",
    "framer-motion": "^12.43.0",
    "idb": "^8.0.3",
    "lucide-react": "^1.28.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "playwright-core": "^1.62.1",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wait-on": "^9.1.0"
  },
  "main": "dist-electron/main.js",
  "description": "StudyOS — smart learning platform with focus tools and app blocker",
  "author": "StudyOS"
}
